# Copy to .env for local development (never commit .env)

# Google OAuth "Web application" client ID. Leave empty to use the local dev sign-in instead.
GOOGLE_CLIENT_ID=

# Any long random string; signs the session cookie. Required in production.
SESSION_SECRET=

# Postgres connection string. Leave empty locally to store accounts in server/data/dev-db.json.
DATABASE_URL=

PORT=3001
