{
  "name": "ese-ece-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "ESE ECE Stage 1 coverage tracker and previous-year question library",
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.19.2",
    "google-auth-library": "^11.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=20"
  }
}
